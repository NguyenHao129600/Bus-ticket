NODE_ENV=development
APP_HOST=localhost
APP_PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bus_booking
DB_CONNECTION_LIMIT=10

JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

LOG_DIR=logs
LOG_LEVEL=info
